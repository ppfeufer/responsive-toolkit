{
    "author": "Peter Pfeufer",
    "name": "@ppfeufer/responsive-toolkit",
    "version": "0.0.3",
    "description": "Responsive Toolkit allows for easy breakpoint detection in JavaScript",
    "license": "GPL-3.0-or-later",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/ppfeufer/responsive-toolkit"
    },
    "bugs": {
        "url": "https://github.com/ppfeufer/responsive-toolkit/issues"
    },
    "files": [
        "dist"
    ],
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.4.1",
        "globals": "^17.6.0",
        "sass": "^1.101.0",
        "stylelint": "^17.12.0",
        "stylelint-config-standard": "^40.0.0",
        "terser": "^5.48.0"
    },
    "scripts": {
        "copy:css": "mkdir -p dist/css && cp src/responsive-toolkit.css dist/css/responsive-toolkit.css",
        "copy:js": "mkdir -p dist/js && cp src/responsive-toolkit.js dist/js/responsive-toolkit.js",
        "copy:sources": "npm run copy:css && npm run copy:js",
        "build": "npm run copy:sources && npm run minify",
        "lint:js": "eslint --config eslint.config.js --ext .js --ignore-pattern '**/*.min.js' --debug",
        "lint:css": "stylelint -f verbose \"**/*.css\" --config .stylelintrc.json --ignore-pattern '**/*.min.css' --ignore-pattern 'dist/**'",
        "lint": "npm run lint:js && npm run lint:css",
        "minify:css": "sass dist/css/responsive-toolkit.css:dist/css/responsive-toolkit.min.css --style compressed",
        "minify:js": "terser dist/js/responsive-toolkit.js -o dist/js/responsive-toolkit.min.js --source-map \"base='dist/js/',url='responsive-toolkit.min.js.map'\" --compress reduce_vars=false --mangle --format quote_style=1",
        "minify": "npm run minify:js && npm run minify:css"
    }
}
